<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:padding="@dimen/espaciado_l">

    <ImageView
        android:id="@+id/ivIconoBienvenida"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="@color/verde_principal"
        android:contentDescription="@null"
        android:padding="18dp"
        android:src="@drawable/ic_money"
        app:layout_constraintBottom_toTopOf="@id/tvTituloBienvenida"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvTituloBienvenida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_l"
        android:gravity="center"
        android:text="@string/bienvenida_titulo"
        android:textColor="@color/texto_principal"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivIconoBienvenida" />

    <TextView
        android:id="@+id/tvDescripcionBienvenida"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_m"
        android:gravity="center"
        android:text="@string/bienvenida_descripcion"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_cuerpo"
        app:layout_constraintBottom_toTopOf="@id/btnEmpezar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloBienvenida" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmpezar"
        style="@style/BotonPrimario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_xl"
        android:text="@string/bienvenida_boton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescripcionBienvenida"
        app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
