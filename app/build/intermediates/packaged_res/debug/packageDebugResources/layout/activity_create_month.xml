<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:orientation="vertical"
        android:padding="@dimen/espaciado_l"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/accion_volver"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/TextoTituloHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_s"
                android:text="@string/crear_mes_titulo" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaciado_m"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerMes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/espaciado_s" />

            <Spinner
                android:id="@+id/spinnerAnio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaciado_s"
                android:layout_weight="1"
                android:background="@drawable/bg_card_rounded"
                android:padding="@dimen/espaciado_s" />

        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/espaciado_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaciado_l">

            <TextView
                style="@style/EtiquetaCampo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/crear_mes_dinero_disponible" />

            <EditText
                android:id="@+id/etDineroDisponible"
                style="@style/TextoImporteGrande"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="0,00 €"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:inputType="numberDecimal"
                android:digits="0123456789,"
                android:paddingTop="@dimen/espaciado_s"
                android:paddingBottom="@dimen/espaciado_m" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/espaciado_l"
                android:background="@color/borde_chip" />

            <TextView
                style="@style/EtiquetaCampo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaciado_s"
                android:text="@string/crear_mes_porcentaje_categorias" />

            <include
                android:id="@+id/filaGeneral"
                layout="@layout/item_category_percent_input" />

            <include
                android:id="@+id/filaAhorro"
                layout="@layout/item_category_percent_input" />

            <include
                android:id="@+id/filaInversion"
                layout="@layout/item_category_percent_input" />

            <include
                android:id="@+id/filaOcio"
                layout="@layout/item_category_percent_input" />

            <include
                android:id="@+id/filaCultura"
                layout="@layout/item_category_percent_input" />

            <TextView
                android:id="@+id/tvErrorPorcentaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_xs"
                android:textColor="@color/rojo_limite"
                android:textSize="@dimen/texto_pequeno"
                android:visibility="gone" />

            <com.warthogcash.presupuesto.ui.common.WarningBannerView
                android:id="@+id/bannerMesAnteriorAbierto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_m"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearMes"
                style="@style/BotonPrimario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaciado_l"
                android:text="@string/crear_mes_boton" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
