<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedorHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header_rounded"
    android:paddingHorizontal="@dimen/espaciado_l"
    android:paddingTop="@dimen/espaciado_l"
    android:paddingBottom="@dimen/espaciado_l">

    <ImageButton
        android:id="@+id/btnVolver"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/accion_volver"
        android:src="@drawable/ic_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloMes"
        style="@style/TextoTituloHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaciado_s"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/btnVolver"
        app:layout_constraintEnd_toStartOf="@id/ivCalendario"
        app:layout_constraintStart_toEndOf="@id/btnVolver"
        app:layout_constraintTop_toTopOf="@id/btnVolver"
        tools:text="Mayo 2026" />

    <TextView
        android:id="@+id/tvEtiquetaDisponible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.85"
        android:text="@string/principal_disponible"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_cuerpo"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivCalendario"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_badge_actual"
        android:backgroundTint="#33FFFFFF"
        android:contentDescription="@string/mis_meses_titulo"
        android:padding="6dp"
        android:src="@drawable/ic_calendar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDisponible"
        style="@style/TextoImporteHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEtiquetaDisponible"
        tools:text="1.284,50 €" />

    <TextView
        android:id="@+id/tvEstadoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_s"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_pequeno"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDisponible"
        tools:text="● Mes abierto" />

    <TextView
        android:id="@+id/tvEtiquetaIngreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaciado_m"
        android:alpha="0.85"
        android:text="@string/principal_ingreso"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_pequeno"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEstadoBadge" />

    <TextView
        android:id="@+id/tvIngreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blanco"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEtiquetaIngreso"
        tools:text="2.000,00 €" />

    <TextView
        android:id="@+id/tvEtiquetaGastado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.85"
        android:text="@string/principal_gastado"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_pequeno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvEtiquetaIngreso" />

    <TextView
        android:id="@+id/tvGastado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/blanco"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvIngreso" />

</androidx.constraintlayout.widget.ConstraintLayout>
