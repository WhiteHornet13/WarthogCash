    <style name="BotonPrimario" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/verde_principal</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="ChipCategoria">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
    <style name="EtiquetaCampo">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">@dimen/texto_pequeno</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
    <style name="TextoImporteGrande">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">@dimen/texto_importe_grande</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextoImporteHeader">
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">@dimen/texto_disponible_header</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextoTituloHeader">
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.WarthogCash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verde_principal</item>
        <item name="colorPrimaryVariant">@color/verde_principal</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/acento_ambar</item>
        <item name="colorOnSecondary">@color/texto_principal</item>
        <item name="android:windowBackground">@color/fondo_pantalla</item>
        <item name="android:statusBarColor">@color/verde_principal</item>
        <item name="android:navigationBarColor">@color/fondo_pantalla</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.WarthogCash.Splash">
        <item name="android:windowBackground">@color/fondo_pantalla</item>
        <item name="android:statusBarColor">@color/fondo_pantalla</item>
    </style>
</resources>