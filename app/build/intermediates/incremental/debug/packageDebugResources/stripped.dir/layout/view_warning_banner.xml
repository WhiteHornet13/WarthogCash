<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contenedorBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_borde_suave"
    android:orientation="horizontal"
    android:padding="@dimen/espaciado_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/espaciado_s"
        android:text="ⓘ"
        android:textColor="@color/texto_secundario"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMensajeBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_cuerpo"
        tools:text="Este mes está cerrado y no admite traspasos ni edición." />

</LinearLayout>
