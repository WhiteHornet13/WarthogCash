<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <com.warthogcash.presupuesto.ui.common.MonthSummaryHeaderView
        android:id="@+id/headerResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <com.warthogcash.presupuesto.ui.common.WarningBannerView
        android:id="@+id/bannerMesCerrado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espaciado_l"
        android:layout_marginTop="@dimen/espaciado_m"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerResumen"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tvEtiquetaCategorias"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaciado_l"
        android:layout_marginTop="@dimen/espaciado_l"
        android:letterSpacing="0.05"
        android:text="@string/crear_mes_porcentaje_categorias"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_pequeno"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bannerMesCerrado" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaCategorias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espaciado_s"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/espaciado_l"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toTopOf="@id/btnCerrarMes"
        app:layout_constraintTop_toBottomOf="@id/tvEtiquetaCategorias"
        tools:listitem="@layout/item_categoria_card" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarMes"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/espaciado_l"
        android:layout_marginBottom="@dimen/espaciado_m"
        android:text="@string/detalle_boton_cerrar_mes"
        android:textAllCaps="false"
        android:textColor="@color/rojo_limite"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/rojo_limite"
        tools:visibility="visible" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAnadirGasto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/espaciado_l"
        android:backgroundTint="@color/acento_ambar"
        android:contentDescription="@string/accion_anadir_gasto"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnCerrarMes"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/blanco"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
