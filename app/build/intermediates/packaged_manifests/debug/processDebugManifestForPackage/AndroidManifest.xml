<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.warthogcash.presupuesto"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.warthogcash.presupuesto.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.warthogcash.presupuesto.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.warthogcash.presupuesto.App"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.WarthogCash" >

        <!--
             Decide de forma centralizada si procede Bienvenida o Pantalla principal,
             según exista o no algún mes creado (ver spec "Bienvenida", punto 2).
        -->
        <activity
            android:name="com.warthogcash.presupuesto.ui.welcome.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.WarthogCash.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.warthogcash.presupuesto.ui.welcome.WelcomeActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.main.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.mymonths.MyMonthsActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.monthdetail.MonthDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.createmonth.CreateMonthActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.addexpense.AddExpenseActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.history.ExpenseHistoryActivity"
            android:exported="false" />
        <activity
            android:name="com.warthogcash.presupuesto.ui.closemonth.CloseMonthActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.warthogcash.presupuesto.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>