<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espaciado_l"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accion_volver"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/TextoTituloHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaciado_s"
            android:text="@string/ajustes_titulo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espaciado_l">

            <TextView
                style="@style/EtiquetaCampo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaciado_s"
                android:text="@string/ajustes_gastos_titulo" />

            <LinearLayout
                android:id="@+id/filaGastosFijos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaciado_s"
                android:background="@drawable/bg_card_rounded"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espaciado_m">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gastos_fijos_titulo"
                    android:textColor="@color/texto_principal"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/texto_secundario"
                    android:textSize="18sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/filaPorcentajesPredefinidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espaciado_l"
                android:background="@drawable/bg_card_rounded"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espaciado_m">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ajustes_porcentajes_titulo"
                    android:textColor="@color/texto_principal"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ivChevronPorcentajes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/texto_secundario"
                    android:textSize="18sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorPorcentajes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/espaciado_m"
                    android:text="@string/ajustes_porcentajes_descripcion"
                    android:textColor="@color/texto_secundario"
                    android:textSize="@dimen/texto_pequeno" />

                <include
                    android:id="@+id/filaGeneral"
                    layout="@layout/item_category_percent_input" />

                <include
                    android:id="@+id/filaAhorro"
                    layout="@layout/item_category_percent_input" />

                <include
                    android:id="@+id/filaInversion"
                    layout="@layout/item_category_percent_input" />

                <include
                    android:id="@+id/filaOcio"
                    layout="@layout/item_category_percent_input" />

                <include
                    android:id="@+id/filaCultura"
                    layout="@layout/item_category_percent_input" />

                <TextView
                    android:id="@+id/tvErrorPorcentaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_xs"
                    android:textColor="@color/rojo_limite"
                    android:textSize="@dimen/texto_pequeno"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarAjustes"
                    style="@style/BotonPrimario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espaciado_l"
                    android:text="@string/ajustes_boton_guardar" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
