<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/espaciado_m">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDescripcionGasto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textStyle="bold"
            tools:text="Compra semanal" />

        <TextView
            android:id="@+id/tvFechaCategoriaGasto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/texto_secundario"
            android:textSize="@dimen/texto_pequeno"
            tools:text="Hoy · General" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvImporteGasto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_principal"
        android:textStyle="bold"
        tools:text="−24,90 €" />

    <ImageButton
        android:id="@+id/btnEditarGasto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/espaciado_s"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/historial_accion_editar_gasto"
        android:padding="6dp"
        android:src="@drawable/ic_edit" />

    <ImageButton
        android:id="@+id/btnEliminarGasto"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/historial_accion_eliminar_gasto"
        android:padding="6dp"
        android:src="@drawable/ic_delete" />

</LinearLayout>

