<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/blanco" />
            <corners android:radius="@dimen/radio_esquina_tarjeta" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="@color/acento_ambar" />
            <corners
                android:topLeftRadius="@dimen/radio_esquina_tarjeta"
                android:bottomLeftRadius="@dimen/radio_esquina_tarjeta"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
