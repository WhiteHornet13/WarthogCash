<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextoTituloHeader">
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoImporteHeader">
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textSize">@dimen/texto_disponible_header</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextoImporteGrande">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">@dimen/texto_importe_grande</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EtiquetaCampo">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">@dimen/texto_pequeno</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="FilaOpcionFunciones">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="BotonPrimario" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/verde_principal</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="ChipCategoria">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="ThemeOverlay.WarthogCash.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/verde_principal</item>
        <item name="colorAccent">@color/verde_principal</item>
        <item name="android:windowBackground">@color/blanco</item>
        <item name="android:textColorPrimary">@color/texto_principal</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:textColorPrimaryInverse">@color/texto_principal</item>
    </style>
</resources>
