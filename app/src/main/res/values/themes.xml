<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WarthogCash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verde_principal</item>
        <item name="colorPrimaryVariant">@color/verde_principal</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/acento_ambar</item>
        <item name="colorOnSecondary">@color/texto_principal</item>
        <item name="android:windowBackground">@color/fondo_pantalla</item>
        <item name="android:statusBarColor">@color/verde_principal</item>
        <item name="android:navigationBarColor">@color/fondo_pantalla</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.WarthogCash.Splash">
        <item name="android:windowBackground">@color/fondo_pantalla</item>
        <item name="android:statusBarColor">@color/fondo_pantalla</item>
